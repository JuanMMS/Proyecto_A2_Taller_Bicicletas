<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="viewController.MecanicoViewController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="GESTIÓN DE MECÁNICOS"/>

    <HBox spacing="10">
        <Label text="ID:"/>
        <TextField fx:id="txtId" promptText="Ingrese el ID"/>

        <Label text="Nombre:"/>
        <TextField fx:id="txtNombre" promptText="Ingrese el nombre"/>

        <Label text="Apellido:"/>
        <TextField fx:id="txtApellido" promptText="Ingrese el apellido"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="btnCrear"
                text="Crear"
                onAction="#onAgregarMecanico"/>

        <Button fx:id="btnModificar"
                text="Modificar"
                onAction="#onActualizarMecanico"/>

        <Button fx:id="btnEliminar"
                text="Eliminar"
                onAction="#onEliminarMecanico"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#onLimpiarCampos"/>
    </HBox>

    <TableView fx:id="tblListMecanico">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"/>

            <TableColumn fx:id="colApellido"
                         text="Apellido"/>

        </columns>

    </TableView>

</VBox>