<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="viewController.VentanaPrincipalViewController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="TALLER DE BICICLETAS"/>

    <Label text="Menú principal"/>

    <GridPane hgap="15" vgap="15">

        <Button text="Gestionar Clientes"
                onAction="#onAbrirClientes"
                prefWidth="180"
                prefHeight="50"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

        <Button text="Gestionar Mecánicos"
                onAction="#onAbrirMecanicos"
                prefWidth="180"
                prefHeight="50"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

        <Button text="Gestionar Bicicletas"
                onAction="#onAbrirBicicletas"
                prefWidth="180"
                prefHeight="50"
                GridPane.columnIndex="0"
                GridPane.rowIndex="1"/>

        <Button text="Órdenes de Servicio"
                onAction="#onAbrirOrdenesServicio"
                prefWidth="180"
                prefHeight="50"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"/>

        <Button text="Consultas"
                onAction="#onAbrirConsultas"
                prefWidth="180"
                prefHeight="50"
                GridPane.columnIndex="0"
                GridPane.rowIndex="2"/>

    </GridPane>

</VBox>