<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.ClienteViewController">

    <children>

        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <children>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="GESTIÓN DE CLIENTES" />

                <GridPane hgap="10.0" vgap="10.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="30.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="30.0" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                    <children>

                        <Label text="Cédula:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                        <TextField fx:id="txtCedula" promptText="Ingrese la cédula" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                        <TextField fx:id="txtNombre" promptText="Ingrese el nombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                        <TextField fx:id="txtTelefono" promptText="Ingrese el teléfono" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                        <TextField fx:id="txtCorreo" promptText="Ingrese el correo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    </children>

                </GridPane>

                <HBox spacing="10.0">

                    <Button fx:id="btnCrear" onAction="#onAgregarCliente" text="Crear" />

                    <Button fx:id="btnModificar" onAction="#onActualizarCliente" text="Modificar" />

                    <Button fx:id="btnEliminar" onAction="#onEliminarCliente" text="Eliminar" />

                    <Button fx:id="btnLimpiar" onAction="#onLimpiarCampos" text="Limpiar" />

                </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
      
                      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Lista de clientes">
                     <HBox.margin>
                        <Insets right="300.0" />
                     </HBox.margin>
                  </Label>
                  <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleVolverVentanaPrincipal" text="Volver" />
               </children>
            </HBox>

                <TableView fx:id="tblListCliente" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colCedula" prefWidth="150.0" text="Cédula" />

                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />

                        <TableColumn fx:id="colTelefono" prefWidth="150.0" text="Teléfono" />

                        <TableColumn fx:id="colCorreo" prefWidth="250.0" text="Correo" />

                    </columns>

                </TableView>

            </children>

            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

        </VBox>

    </children>

</AnchorPane>
