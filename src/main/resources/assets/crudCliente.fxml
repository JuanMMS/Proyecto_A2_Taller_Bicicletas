<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="viewController.ClienteViewController">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <children>

                <Label text="GESTIÓN DE CLIENTES"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <GridPane hgap="10.0" vgap="10.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="30.0"/>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="30.0"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>

                    <children>

                        <Label text="Cédula:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtCedula"
                                   promptText="Ingrese la cédula"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Nombre:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Ingrese el nombre"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="0"/>

                        <Label text="Teléfono:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtTelefono"
                                   promptText="Ingrese el teléfono"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Correo:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtCorreo"
                                   promptText="Ingrese el correo"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="1"/>

                    </children>

                </GridPane>

                <HBox spacing="10.0">

                    <Button text="Crear"
                            fx:id="btnCrear"
                            onAction="#onAgregarCliente"/>

                    <Button text="Modificar"
                            fx:id="btnModificar"
                            onAction="#onActualizarCliente"/>

                    <Button text="Eliminar"
                            fx:id="btnEliminar"
                            onAction="#onEliminarCliente"/>

                    <Button text="Limpiar"
                            fx:id="btnLimpiar"
                            onAction="#onLimpiarCampos"/>

                </HBox>

                <Label text="Lista de clientes"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TableView fx:id="tblListCliente"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colCedula"
                                     text="Cédula"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="200.0"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="colCorreo"
                                     text="Correo"
                                     prefWidth="250.0"/>

                    </columns>

                </TableView>

            </children>

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="10.0"/>
            </padding>

        </VBox>

    </children>

</AnchorPane>