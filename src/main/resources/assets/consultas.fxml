<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.ConsultasViewController">

    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
      
              <VBox prefHeight="100.0" prefWidth="752.0" spacing="5.0">
                  <children>
      
                      <Label text="Consultas del Taller" textFill="#1d3557">
                          <font>
                              <Font name="System Bold" size="22.0" />
                          </font>
                      </Label>
      
                      <Label text="Consulta de historial, órdenes de servicio y stock" textFill="#457b9d" />
      
                      <Separator />
      
                  </children>
              </VBox>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleVolverVentanaPrincipal" prefHeight="100.0" prefWidth="94.0" text="Volver" />
         </children>
      </HBox>


        <!-- HISTORIAL POR SERIAL -->

        <Label text="Historial de bicicleta">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <HBox spacing="10.0">
            <children>

                <TextField fx:id="txtSerial" prefWidth="250.0" promptText="Serial de la bicicleta" />

                <Button fx:id="btnBuscarSerial" onAction="#handleBuscarSerial" text="Buscar historial" />

            </children>
        </HBox>

        <TableView fx:id="tablaHistorial" prefHeight="200.0">

            <columns>

                <TableColumn fx:id="colIdHistorial" prefWidth="100.0" text="ID Servicio" />

                <TableColumn fx:id="colFechaHistorial" prefWidth="100.0" text="Fecha" />

                <TableColumn fx:id="colMotivoHistorial" prefWidth="180.0" text="Motivo" />

                <TableColumn fx:id="colDiagnosticoHistorial" prefWidth="180.0" text="Diagnóstico" />

                <TableColumn fx:id="colTrabajoHistorial" prefWidth="180.0" text="Trabajo realizado" />

                <TableColumn fx:id="colCostoHistorial" prefWidth="100.0" text="Costo" />

            </columns>

        </TableView>


        <!-- ÓRDENES POR FECHA -->

        <Label text="Órdenes de servicio por fecha">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <HBox spacing="10.0">
            <children>

                <DatePicker fx:id="dpFecha" promptText="Seleccionar fecha" />

                <Button fx:id="btnBuscarFecha" onAction="#handleBuscarFecha" text="Buscar órdenes" />

            </children>
        </HBox>

        <TableView fx:id="tablaFecha" prefHeight="200.0">

            <columns>

                <TableColumn fx:id="colIdFecha" prefWidth="100.0" text="ID Servicio" />

                <TableColumn fx:id="colFechaOrden" prefWidth="100.0" text="Fecha" />

                <TableColumn fx:id="colMotivoFecha" prefWidth="180.0" text="Motivo" />

                <TableColumn fx:id="colDiagnosticoFecha" prefWidth="180.0" text="Diagnóstico" />

                <TableColumn fx:id="colTrabajoFecha" prefWidth="180.0" text="Trabajo realizado" />

                <TableColumn fx:id="colCostoFecha" prefWidth="100.0" text="Costo" />

            </columns>

        </TableView>


        <!-- STOCK -->

        <Separator />

        <HBox alignment="CENTER_LEFT" spacing="15.0">

            <children>

                <Button fx:id="btnStock" onAction="#handleStock" text="Consultar stock" />

                <Label fx:id="lblStock" text="Stock: no consultado" />

            </children>

        </HBox>

    </children>

</VBox>
